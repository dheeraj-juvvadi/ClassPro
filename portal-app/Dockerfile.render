FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN apt-get update && apt-get install -y --no-install-recommends \
  chromium \
  chromium-driver \
  fonts-liberation \
  libnss3 \
  libatk-bridge2.0-0 \
  libgtk-3-0 \
  libx11-xcb1 \
  libxcomposite1 \
  libxdamage1 \
  libxrandr2 \
  libgbm1 \
  libasound2 \
  python3 \
  python3-pip \
  python3-venv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY requirements-ocr.txt ./
RUN python3 -m venv .venv-ocr \
  && .venv-ocr/bin/pip install --no-cache-dir -r requirements-ocr.txt

COPY . .

ENV PORTAL_BROWSER_PATH=/usr/bin/chromium
ENV PORTAL_OCR_PYTHON=/app/.venv-ocr/bin/python
ENV HOST=0.0.0.0
ENV PORT=10000

EXPOSE 10000
CMD ["node", "src/server.js"]
